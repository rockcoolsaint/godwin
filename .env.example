NODE_ENV=<production|development>
NEXT_PUBLIC_APP_API_SERVER_URL=<your-django-backend-url>
NEXT_PUBLIC_APP_WS_SERVER_URL=<your-django-ws-backend-url>
NEXT_PUBLIC_APP_CALLBACK_URL=<your-frontend-base-url>

NEXT_PUBLIC_AUTH0_DOMAIN=<your-auth0-domain>
NEXT_PUBLIC_AUTH0_CLIENT_ID=<your-auth0-client-id>
NEXT_PUBLIC_AUTH0_LOGIN_REDIRECT_URL=<your-redirect-url>

NEXT_PUBLIC_GA_MEASUREMENT_ID=ga_id
NEXT_PUBLIC_INTERCOM_ID=app_id